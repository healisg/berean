# Copy to .env.local for local dev. On Replit, add these under Tools -> Secrets instead.
# Never commit real values - .env.local is gitignored.

# Claude API (Anthropic) - core intelligence layer
ANTHROPIC_API_KEY=your_api_key_here

# Bible verse lookup
YOUVERSION_API_KEY=your_youversion_key_here

# ESV translation - pending Crossway approval
ESV_API_KEY=your_esv_key_here

# Supabase - auth + practice session storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
